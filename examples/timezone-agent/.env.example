# Arthur Configuration
# Your Arthur instance URL (e.g., https://app.arthur.ai or your self-hosted instance)
ARTHUR_BASE_URL=http://localhost:3030

# Your Arthur API key (get this from your Arthur dashboard)
ARTHUR_API_KEY=your_arthur_api_key_here

# Your Arthur Task ID (you should have created this task already)
ARTHUR_TASK_ID=your_task_id_here

# OpenAI Configuration
# Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here 